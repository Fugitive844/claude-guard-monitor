#!/bin/sh /etc/rc.common
USE_PROCD=1
START=25
STOP=85
start_service() {
    procd_open_instance monitor
    procd_set_param command /usr/bin/claude-guard-monitor -config /etc/claude-guard-monitor/config.json
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param limits nofile="2048 2048"
    procd_close_instance
}
stop_service() {
    logger -t claude-guard-monitor 'Monitor stopped; independent protection retained.'
}
